{
  "name": "foxmd",
  "version": "0.3.3",
  "description": "An opinionated library that can turn Markdown string into `React.ReactNode[]`",
  "repository": {
    "url": "https://github.com/SukkaW/foxmd"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "bunchee --minify --no-sourcemap",
    "prerelease": "pnpm run lint && pnpm run build",
    "release": "bumpp --install -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "markdown",
    "react",
    "react-server-component",
    "rsc",
    "transformer",
    "marked",
    "marked-js"
  ],
  "author": "SukkaW <https://skk.moe>",
  "license": "MIT",
  "dependencies": {
    "domhandler": "^5.0.3",
    "fast-escape-regexp": "^1.0.1",
    "foxts": "^5.9.1",
    "html-entities": "^2.6.0",
    "htmlparser2": "^10.1.0",
    "marked": "^15.0.12",
    "postcss": "^8.5.26",
    "postcss-js": "^5.1.0",
    "remove-accents": "0.5.0"
  },
  "devDependencies": {
    "@types/postcss-js": "^4.1.0",
    "@types/react": "^19.2.18",
    "bumpp": "^10.4.1",
    "bunchee": "^6.12.2",
    "eslint": "^10.8.1",
    "eslint-config-sukka": "^9.0.1",
    "eslint-formatter-sukka": "^9.0.1",
    "html-tags": "^5.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "*"
  },
  "packageManager": "pnpm@11.20.0"
}
